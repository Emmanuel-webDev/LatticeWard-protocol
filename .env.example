# ── Network ──
QOR_EVM_RPC=https://evm-testnet.qore.host
QOR_REST_API=https://api-testnet.qore.host
QOR_CHAIN_ID=9800
EXPLORER_TX_URL=https://explore.qore.network/tx/{hash}

# ── Deployed contracts ──
VAULT_ADDRESS=
FUSD_ADDRESS=0x97143B771D34ddb9130b807b135Ae675A5a963CA
PQC_RECIPIENT=          # an address with a registered ML-DSA-87 key (payout target for happy-path tests)

# ── Scoped policy caps (for script/Deploy.s.sol) ──
# fUSD on qorechain-diana has 6 decimals (1 fUSD = 1_000_000); native QOR on EVM has 18 decimals (1 QOR = 10^18).
# LW_MAX_TX_FUSD=1000000               # 1 fUSD (6 decimals)
# LW_EPOCH_LIMIT_FUSD=3000000          # 3 fUSD (6 decimals)
# LW_MAX_TX_QOR=100000000000000000     # 0.1 QOR (18 decimals)
# LW_EPOCH_LIMIT_QOR=300000000000000000 # 0.3 QOR (18 decimals)
# LW_WINDOW_DAYS=14

# ── Keys (TESTNET ONLY. NEVER reuse a key that has ever held real funds) ──
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=      # disposable classical agent key (Plane 1)
LEAKED_PRIVATE_KEY=     # key handed to the attacker bot / simulated leak (defaults to AGENT_PRIVATE_KEY)
SOVEREIGN_PK_HEX=       # 0x… 2592-byte ML-DSA-87 public key  (npm run gen:sovereign)
SOVEREIGN_SK_HEX=       # 0x… 4896-byte ML-DSA-87 secret key  (keep OUT of git, OUT of the drill account)

# ── Pre-flight ──
RISK_THRESHOLD=0.30     # abort if simulateWithRiskScore >= this (0..1)
